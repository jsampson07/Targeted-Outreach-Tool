DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/outreach
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256

# Contact discovery provider: "mock" (default, no real credits) or "hunter".
CONTACT_PROVIDER=mock
# Required when CONTACT_PROVIDER=hunter. Never commit a real key.
HUNTER_API_KEY=

# Anthropic LLM (structured resume/JD extraction). Required for extract endpoints.
ANTHROPIC_API_KEY=
# Cost-appropriate default for structured extraction (Haiku, not Sonnet/Opus).
LLM_MODEL=claude-haiku-4-5
# Parse/validation retries after the first failed attempt (default: one retry).
LLM_MAX_RETRIES=1
